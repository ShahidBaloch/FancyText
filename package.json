{
  "name": "fancytext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/write-sitemap.mjs && node scripts/write-llms.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:unicode": "node scripts/check-unicode.mjs",
    "check:text": "node scripts/check-text-pipeline.mjs",
    "check:sitemap": "node scripts/write-sitemap.mjs",
    "check:llms": "node scripts/write-llms.mjs",
    "check:kaomoji-catalog": "node scripts/check-kaomoji-catalog.mjs",
    "check:kaomoji-seo": "node scripts/check-kaomoji-seo.mjs",
    "check:aeo": "node scripts/check-aeo.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "check:google-policy": "node scripts/check-google-policy.mjs",
    "check:policy": "npm run check:sitemap && npm run check:llms && npm run check:kaomoji-catalog && npm run check:kaomoji-seo && npm run check:aeo && npm run check:google-policy"
  },
  "dependencies": {
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
