# Production canonical URL (set the same value in Vercel env)
NEXT_PUBLIC_SITE_URL=https://fancifytext.com

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional — Google Search Console HTML tag verification content value
# (Search Console → Settings → Ownership verification → HTML tag)
# NEXT_PUBLIC_GSC_VERIFICATION=
