# Production canonical URL (set the same value in Vercel env)
NEXT_PUBLIC_SITE_URL=https://fancifytext.com

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C2GKTBXQ4D

# Optional — Google Search Console HTML tag verification content value
# (Search Console → Settings → Ownership verification → HTML tag)
# NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form SMTP (required for /api/contact)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# Do NOT set CONTACT_TO to hello@… if that address Cloudflare-routes back to the
# same Gmail used as SMTP_USER — Gmail hides those as duplicates. With Gmail SMTP
# the API delivers to SMTP_USER automatically.
# CONTACT_TO=your@gmail.com
# Optional From address. Defaults to SMTP_USER. With Gmail SMTP, only set this
# after adding the address under Gmail → Settings → Accounts → Send mail as.
# CONTACT_FROM=hello@fancifytext.com
